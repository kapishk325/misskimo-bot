# Discord Bot Token (Required)
# Obtained from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Groq Cloud API Key (Required)
# Obtained from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Allowed Channel IDs (Optional)
# Comma-separated list of Discord channel IDs where autonomous roasts are enabled.
# Leave blank to allow all channels the bot has access to.
# Example: 123456789012345678,987654321098765432
ALLOWED_CHANNEL_IDS=

# Autonomous Chime-in Chance (Default: 0.12)
# Probability (0.0 to 1.0) of Misskimo chiming in on unprompted messages.
CHIME_CHANCE=0.12

# Autonomous Roast Cooldown in Seconds (Default: 45)
# Minimum interval between autonomous roasts in the same channel.
COOLDOWN_SECONDS=45

# Rolling Channel History Buffer Size (Default: 10)
# Number of recent channel messages provided to Misskimo for conversation context.
MAX_HISTORY_MESSAGES=10
